## 半身近景（第一人称对视感）：头到腰占满屏，底部裁掉，水平居中。
transform ws_close:
    xalign 0.5
    yanchor 0.0
    ypos -50
    zoom 0.52

## 半身近景 + 小跳（【小跳】）。
transform ws_close_hop:
    xalign 0.5
    yanchor 0.0
    ypos -50
    zoom 0.52
    subpixel True
    pause 0.2
    easeout 0.14 yoffset -28
    easein 0.12 yoffset 0

## 中景（虚空对视）：大小与店员立绘一致，居中。
transform ws_mid:
    xalign 0.5
    yanchor 0.0
    ypos 120
    zoom 0.42

## 中景 + 小跳（【小跳】）。
transform ws_mid_hop:
    xalign 0.5
    yanchor 0.0
    ypos 120
    zoom 0.42
    subpixel True
    pause 0.2
    easeout 0.14 yoffset -28
    easein 0.12 yoffset 0

## 沙漠中景（银白色沙漠段）：偏右站位 = 走路进场落点。
transform ws_desert:
    xanchor 0.5
    xpos 0.76
    yanchor 0.0
    ypos 120
    zoom 0.38
    u_sg_amp 0.0
    u_sg_dropout 0.0

## 沙漠中景 + 小跳（【小跳】）。
transform ws_desert_hop:
    xanchor 0.5
    xpos 0.76
    yanchor 0.0
    ypos 120
    zoom 0.38
    u_sg_amp 0.0
    u_sg_dropout 0.0
    subpixel True
    pause 0.2
    easeout 0.14 yoffset -28
    easein 0.12 yoffset 0

## 沙漠中景 + glitch 物化入场（跑动 sequence 结束后的非自然重新登场）。
## ★紧随其后的同一交互内立绘 show 会省略 at 列表★（同走路窗口的处理），
## 否则替换回 ws_desert 时按尾部对齐继承中途值、动画冻在半路。
transform ws_desert_glitchin:
    xanchor 0.5
    xpos 0.76
    yanchor 0.0
    ypos 120
    zoom 0.38
    u_sg_amp 0.0
    u_sg_dropout 0.0
    mesh True
    shader "game.sprite_glitch"
    u_sg_top 0.0
    u_sg_bot 1.0
    u_sg_amp 1.0
    u_sg_dropout 1.0
    parallel:
        easeout 0.5 u_sg_amp 0.0
    parallel:
        easeout 0.4 u_sg_dropout 0.0

## 【从当前位置(缓缓)走到屏幕中心，立绘略微放大】：从走路落点走到屏幕
## 中心，步频比走入略快，边走边微放大（走近镜头）。窗口语义同走路 ——
## 后续 show 省略 at，人留在中心。
transform ws_desert_center_walk:
    subpixel True
    xanchor 0.5
    xpos 0.76
    yanchor 0.0
    ypos 120
    zoom 0.38
    u_sg_amp 0.0
    u_sg_dropout 0.0
    parallel:
        linear 2.0 xpos 0.5
    parallel:
        ease 2.0 zoom 0.5
    parallel:
        block:
            easeout 0.275 yoffset -12
            easein 0.275 yoffset 0
            repeat 4

## 【立绘回归原来大小】：zoom 从继承的放大值缓回常规。★只用于紧接
## 中心走之后的 re-show★ —— zoom 初值靠尾部对齐继承，冷启动会从 1.0
## 缩下来。yoffset 归零兜底（快速点击时可能继承到迈步中途的起伏值）。
transform ws_desert_center:
    xanchor 0.5
    xpos 0.5
    yanchor 0.0
    ypos 120
    yoffset 0
    u_sg_amp 0.0
    u_sg_dropout 0.0
    ease 0.5 zoom 0.38

## 【尤里娅登场】：王霜平滑滑回右侧让位。xpos 从尾部对齐继承的当前值
## ease 过去；zoom 只是兜底归位（正常流程她已是 WS_DESERT_ZOOM，无缩放
## 动作）。无步态起伏 —— 是"画面重新构图"不是走路。
## ★同 ws_desert_center：只用于窗口内 re-show，冷启动无意义★。
transform ws_desert_slide_right:
    xanchor 0.5
    yanchor 0.0
    ypos 120
    yoffset 0
    u_sg_amp 0.0
    u_sg_dropout 0.0
    parallel:
        ease 0.8 xpos 0.76
    parallel:
        ease 0.8 zoom 0.38

