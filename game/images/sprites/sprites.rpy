        easeout 0.4 u_sg_dropout 0.0

## 【尤里娅消失】：异常消失 —— 全身撕裂渐强 + 随机行序逐行掐断
## （信号被掐，不是 fade out）。非阻塞；行全部丢完即不可见，不发
## hide —— 下次 show / scene 自然接管（同店员退场的处理）。
transform yl_vanish:
    xanchor 0.5
    xpos 0.26
    yanchor 0.0
    ypos 110
    zoom 0.37
    u_sg_amp 0.0
    u_sg_dropout 0.0
    mesh True
    shader "game.sprite_glitch"
    u_sg_top 0.0
    u_sg_bot 1.0
    u_sg_dropout 0.0
    u_sg_amp 0.0
    parallel:
        easein 0.45 u_sg_amp 1.0
    parallel:
        pause 0.113
        easein 0.338 u_sg_dropout 1.0

## 【尤里娅异变】第一拍：人形高频痉挛 + 身体异常纵向拉伸抽动 +
## 撕裂渐强 + 血色从内漫延淹没全身 —— 转换器配 hard_pause 锁住整拍，
## 红闪（mutation_flash）后第二拍尸首（yl_corpse_in）扑入。
transform yl_mutate:
    xanchor 0.5
    xpos 0.26
    yanchor 0.0
    ypos 110
    zoom 0.37
    u_sg_amp 0.0
    u_sg_dropout 0.0
    mesh True
    shader "game.sprite_glitch"
    u_sg_top 0.0
    u_sg_bot 1.0
    u_sg_dropout 0.0
    u_sg_amp 0.0
    subpixel True
    matrixcolor TintMatrix("#ffffff")
    parallel:
        easein 0.7 u_sg_amp 1.0
    parallel:
        # 血色漫延：结构相同的 TintMatrix 之间逐参数插值
        ease 0.7 matrixcolor TintMatrix("#b32020")
    parallel:
        # 高频痉挛
        block:
            linear 0.04 xoffset -12
            linear 0.04 xoffset 12
            repeat
    parallel:
        # 身体异常拉伸抽动（血肉在错误地重组）
        block:
            easeout 0.16 yzoom 1.07
            easein 0.12 yzoom 0.96
            repeat
    parallel:
        pause 0.42
        easein 0.28 u_sg_dropout 0.6

## 尸首形态（横构图缝合怪）：头与王霜立绘的头等大，左侧骨头出画。
transform yl_corpse_pos:
    xanchor 0.5
    xpos 0.15
    yanchor 0.0
    ypos -330
    zoom 0.7

## 尸首 glitch 物化入场（跑动 sequence 结束后的重新登场）。
transform yl_corpse_glitchin:
    xanchor 0.5
    xpos 0.15
    yanchor 0.0
    ypos -330
    zoom 0.7
    mesh True
    shader "game.sprite_glitch"
    u_sg_top 0.0
    u_sg_bot 1.0
    u_sg_amp 1.0
    u_sg_dropout 1.0
    parallel:
        easeout 0.5 u_sg_amp 0.0
    parallel:
        easeout 0.4 u_sg_dropout 0.0

## 异变第二拍：尸首从深处扑到眼前 —— 以头部为锚点、zoom 从 LUNGE 倍
## 猛冲到位（脸原地朝你放大）+ 撕裂收敛落定（配红闪余韵和 fx_shock）。
## 锚点坐标由 YL_CORPSE_HEAD/IMG 换算，落位与 yl_corpse_pos 完全一致。
transform yl_corpse_in:
    # 从 yl_mutate 尾部对齐继承来的痉挛/拉伸/血色中间值全部显式复位
    xoffset 0
    yzoom 1.0
    matrixcolor TintMatrix("#ffffff")
    xanchor 0.68
    yanchor 0.32
    xpos 798
    ypos 292
    mesh True   # 同 sg_full：隔离图内同名 shader + 作用带按整图算
    shader "game.sprite_glitch"
    u_sg_top 0.0
    u_sg_bot 1.0
    u_sg_dropout 0.0
    u_sg_amp 1.0
    zoom 0.385
    parallel:
        easeout 0.22 zoom 0.7
    parallel:
        easeout 0.4 u_sg_amp 0.0

## 异变切换瞬间的满屏红闪：show 即峰值、随后褪尽。scene 时被清掉。
image mutation_flash:
    Solid("#c81616", xysize=(1920, 1080))
    alpha 0.85
    linear 0.35 alpha 0.0

## 沙漠走路进场（【王霜走路进场】）：左缘外走到画面偏右，水平匀速 +
## 每步一次起伏。落点即站定位置 —— 走路窗口内的后续姿势 show 不带 at
## 列表，沿用本 transform 的落点（见 convert_script.py 走路窗口逻辑）。
## subpixel：起伏只有十几像素，不开亚像素会整像素跳格。
transform ws_desert_walk:
    subpixel True
    xanchor 0.5
    xpos -0.3
    yanchor 0.0
    ypos 120
    zoom 0.38
    parallel:
        linear 10.0 xpos 0.76
    parallel:
        block:
            easeout 0.3 yoffset -12
            easein 0.3 yoffset 0
            repeat 17

## 店员（王霜复制体，甜品店段）：右侧正立。
transform ws_clerk_right:
    xanchor 0.5
    xpos 0.82
    yanchor 0.0
    ypos 120
    zoom 0.42

## 店员1入场：从屏幕下方升上来（非阻塞，与店员2 的降下对称）。
transform ws_clerk_right_enter:
    xanchor 0.5
    xpos 0.82
    yanchor 0.0
    ypos 120
    zoom 0.42
    yoffset 1100
    ease 0.7 yoffset 0

## 店员1退场：垂直平移沉出画面（非阻塞）。
transform ws_clerk_right_exit:
    xanchor 0.5
    xpos 0.82
    yanchor 0.0
    ypos 120
    zoom 0.42
    ease 0.7 yoffset 1100

## 店员1 + 小跳（【小跳】）。
transform ws_clerk_right_hop:
    xanchor 0.5
    xpos 0.82
    yanchor 0.0
    ypos 120
    zoom 0.42
    subpixel True
    pause 0.2
    easeout 0.14 yoffset -28
    easein 0.12 yoffset 0

## 店员2：左侧从天花板倒吊（rotate 180，底边=头部下沿）。
transform ws_clerk_ceiling:
    rotate 180
    xanchor 0.5
    xpos 0.18
    yanchor 1.0
    ypos 960
    zoom 0.42

## 店员2入场：从天花板上方倒吊降下（非阻塞）。
transform ws_clerk_ceiling_enter:
    rotate 180
    xanchor 0.5
    xpos 0.18
    yanchor 1.0
    ypos 960
    zoom 0.42
    yoffset -1100
    ease 0.7 yoffset 0

## 店员2退场：垂直平移收回天花板（非阻塞）。
transform ws_clerk_ceiling_exit:
    rotate 180
    xanchor 0.5
    xpos 0.18
    yanchor 1.0
    ypos 960
    zoom 0.42
    ease 0.7 yoffset -1100

## 店员2 + 小跳（【小跳】）：倒吊着向上（天花板方向）弹一下。
transform ws_clerk_ceiling_hop:
    rotate 180
    xanchor 0.5
    xpos 0.18
    yanchor 1.0
    ypos 960
    zoom 0.42
    subpixel True
    pause 0.2
    easeout 0.14 yoffset -28
    easein 0.12 yoffset 0
