    ahe "Am I...sick again?"

# game/scripts/route1.rpy:36
translate english route1_start_809438f8:

    # wangshuang "不，恰恰相反，阿鹤。要我说，你现在就像太阳一样稳定。"
    wangshuang "No, quite the opposite, Kaku. You are as stable as the sun, if I do say so myself."

# game/scripts/route1.rpy:37
translate english route1_start_d98b13e4:

    # ahe "太阳？"
    ahe "The sun?"

# game/scripts/route1.rpy:39
translate english route1_start_1db5dd57:

    # wangshuang "哦，不好意思，太阳在那儿。"
    wangshuang "Ooops, my bad. Yes, the sun, over there."

# game/scripts/route1.rpy:52
translate english route1_start_7b87eb68:

    # wangshuang "你看，太阳。"
    wangshuang "The sun, ya' see it now?"

# game/scripts/route1.rpy:53
translate english route1_start_563a4587:

    # ahe "嗯，太阳。"
    ahe "Yes."

# game/scripts/route1.rpy:54
translate english route1_start_2af121a2:

    # wangshuang "金色的，温暖的，让人舒适而安心的太阳，它就在那里。"
