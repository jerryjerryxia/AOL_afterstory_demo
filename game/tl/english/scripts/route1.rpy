# game/scripts/route1.rpy:55
translate english route1_start_23f3cf89:

    # wangshuang "对于沐浴日光中的人来说，明白这一点就够了。"
    wangshuang "For the ones bathing in the sunlight, that's all they need to know."

# game/scripts/route1.rpy:58
translate english route1_start_4db69fb9:

    # ahe "可我还是觉得我快要..."
    ahe "But I still feel like I'm..."

# game/scripts/route1.rpy:61
translate english route1_start_11fdb519_1:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/route1.rpy:69
translate english route1_start_93961e4b:

    # ahe "那怎么可能是——"
    ahe "How could that——"

# game/scripts/route1.rpy:70
translate english route1_start_94662fc4:

    # wangshuang "当然就是这样的，阿鹤。"
    wangshuang "Of course that is the case, Kaku."

# game/scripts/route1.rpy:73
translate english route1_start_1a6abbda:

    # wangshuang "修补本就完整的东西，那自然是做不到的。"
    wangshuang "I don't think it's possible to fix something that's not broken."

# game/scripts/route1.rpy:75
translate english route1_start_3052b110:

    # wangshuang "你不同意。"
    wangshuang "You seem to disagree."

# game/scripts/route1.rpy:76
translate english route1_start_f61967e3:

    # ahe "...你...求求你不要再浪费我的时间了..."
    ahe "...please...stop wasting my time..."

# game/scripts/route1.rpy:78
translate english route1_start_f523f216:

    # ahe "我还要——我还得..."
    ahe "I still have to...still need to..."

# game/scripts/route1.rpy:84
translate english route1_start_78a73c46:

    # ahe "这...这肯定又是你的把戏！"
    ahe "This...this must be one of your tricks!"

# game/scripts/route1.rpy:85
translate english route1_start_9768a694:

    # wangshuang "总是向外归因可解决不了问题啊，我的朋友。"
    wangshuang "Attributing your problems to external causes all the time won't solve anything, my dear friend."

# game/scripts/route1.rpy:86
translate english route1_start_e2a0603a:

    # wangshuang "你的病虽然看起来已经根治了，但以你的身心状态而言，任何时候复发我都不意外。"
    wangshuang "Your sickness was cured, somewhat. But with the headspace you are in right now, relapse can happen at any minute."

# game/scripts/route1.rpy:89
translate english route1_start_a1a0e806:

    # wangshuang "哦？所以还是想起来了一些。"
    wangshuang "I see, so you remember something after all."

# game/scripts/route1.rpy:90
translate english route1_start_16ae1c8e:

    # ahe "你...毁掉了整个逝乐园。"
    ahe "You...I...we...destroyed the entire PL District."

# game/scripts/route1.rpy:93
translate english route1_start_22cd11c1:

    # wangshuang "你也不用觉得我抬举你，过度谦虚只会让人习惯性地逃避责任，是一种需要调整的心态。"
    wangshuang "And please don't feel like I'm putting you on the spot. Being overly humble is a problematic mentality. It makes you underestimate yourself and keep wanting to run away."

# game/scripts/route1.rpy:98
translate english route1_start_6ee46ea2:

    # wangshuang "哎你看你这人，三天两头向外归因，遇事不决就无视问题——"
    wangshuang "Ah this guy! Imagine saying whatever to everything——"

# game/scripts/route1.rpy:100
translate english route1_start_6d8a84a4:

    # ahe "什么？"
    ahe "What?"

# game/scripts/route1.rpy:104
translate english route1_start_7c394acd:

    # ahe "我不明白..."
    ahe "I don't understand..."

# game/scripts/route1.rpy:106
translate english route1_start_9b7cbbe4:

    # ahe "唔..."
    ahe "Hmm..."

# game/scripts/route1.rpy:111
translate english route1_start_084107bb:

    # wangshuang "想法是轻薄的、由外界塑造的，一坨烂泥一样谁都可以捏一把，但同时也是无足轻重的。而使命则是彻头彻尾、由内而外的——只有在‘使命’松手之后，‘想法’才配拥有虚假的自由。"
    wangshuang "Thoughts are trivial and volatile, like a pile of mud. Everyone can give it a squish and make it into whatever shape they want. The mission, however, is homogeneous to one's being - only when mission loosens its grip can thoughts have a moment of freedom, albeit a fake one."

# game/scripts/route1.rpy:113
translate english route1_start_64c74ff2:

    # ahe "这和我们又有什么关系？"
    ahe "What does that have to do with us?"

# game/scripts/route1.rpy:114
translate english route1_start_82c1fa15:

    # wangshuang "当然有关系了，不然你怎么会出现在这里？"
    wangshuang "Of course, it's got everything to do with us. Or else you wouldn't be here."

# game/scripts/route1.rpy:116
translate english route1_start_ac9c0cab:

    # wangshuang "嗯，‘你’当然不想。"
    wangshuang "Yea, of course 'you' don't."

# game/scripts/route1.rpy:120
translate english route1_start_7115870d:

    # wangshuang "你也可以认为这只是一种较为朴素的过程而已。"
    wangshuang "Or you can think of it as a simple process."

# game/scripts/route1.rpy:125
translate english route1_start_17d8078c:

    # ahe "没说真要来啊..."
    ahe "I wasn't serious..."

# game/scripts/route1.rpy:128
translate english route1_start_331af723:

    # wangshuang "盯——"
    wangshuang "Stare——"

# game/scripts/route1.rpy:132
translate english route1_start_331af723_1:

    # wangshuang "盯——"
    wangshuang "Stare——"

# game/scripts/route1.rpy:135
translate english route1_start_0b39a62c:

    # wangshuang "噗——"
    wangshuang "Ha——"

# game/scripts/route1.rpy:138
translate english route1_start_40f40856:

    # wangshuang "——噗噗呃啊——我败了..."
    wangshuang "——Hahauhhhaaha——I lost..."

# game/scripts/route1.rpy:142
translate english route1_start_a126ec13:

    # wangshuang "你能活到今天确实不容易。"
    wangshuang "It truly is a miracle that you are still alive today, isn't it?"

# game/scripts/route1.rpy:143
translate english route1_start_9174424e:

    # ahe "还不是拜你所赐..."
    ahe "Thanks to you, of course."

# game/scripts/route1.rpy:145
translate english route1_start_e401e8f5:

    # wangshuang "不用谢不用谢。那你来吧，拿走你的战利品。"
    wangshuang "You are welcome. Now come and claim your spoils."

# game/scripts/route1.rpy:146
translate english route1_start_79662878:

    # ahe "哈？"
    ahe "Spoils?"

# game/scripts/route1.rpy:147
translate english route1_start_e2b78fba:

    # wangshuang "别哈，让你来你就来。"
    wangshuang "Don't ask questions. Just get over here."

# game/scripts/route1.rpy:149
translate english route1_start_bff7755f:

    # ahe "是什么东西？"
    ahe "What is it?"

# game/scripts/route1.rpy:150
translate english route1_start_62f865f6:

    # wangshuang "你看就是了。"
    wangshuang "Just take a look."

# game/scripts/route1.rpy:156
translate english route1_start_0085bfa1:

    # ahe "什么都看不到。"
    ahe "I don't see shit."

# game/scripts/route1.rpy:157
translate english route1_start_bbf4d132:

    # wangshuang "凑近啊你，看仔细点！"
    wangshuang "Get closer, for fuck's sake! Pay attention."

# game/scripts/route1.rpy:158
translate english route1_start_f10d3abd:

    # ahe "啊你别拽我！"
    ahe "Ahh stop dragging me!"

# game/scripts/route1.rpy:161
translate english route1_start_1fcf6dda:

    # ahe "呃...嗯？"
    ahe "Huh?"

# game/scripts/route1.rpy:163
translate english route1_start_2d545039:

    # extend "——啊啊啊啊啊啊啊啊啊啊啊！"
    extend "——Ahhhhhhhhhhhhhhhhhhhhhhhhhhhh!!!"

# game/scripts/route1.rpy:167
translate english route1_start_a12951b7:

    # split_right_page_narrator "自你双眼完成聚焦的一瞬，一阵刺眼的光晕便抹去了视野里的一切，仿佛王霜把天上那轮烈日移植进了你的眼球。"
    split_right_page_narrator "As your vision came into focus, a stabbing glare wiped everything from your field of view, as if Shuang transplanted the sun into your eye sockets."

# game/scripts/route1.rpy:172
translate english route1_start_597394bf:

    # split_right_page_narrator "你将身躯团成球状、死死绷住全身肌肉以抵御这钻心之痛，但在光与火的风暴面前也只是杯水车薪。"
    split_right_page_narrator "You curled up your entire body into a ball, flexing every thread of muscle to fight the agony, but it was simply not enough."

# game/scripts/route1.rpy:173
translate english route1_start_10c1f9ec:

    # extend "\n就像太阳一般稳定..."
    extend "\nAs stable as the sun...huh..."

# game/scripts/route1.rpy:174
translate english route1_start_893ef6a2:

    # extend "\n你想立刻去死，那是缓解疼痛的唯一方法，但你非常清楚，此刻死亡就和使命一样遥不可及。"
    extend "\nYou wanted death. That would ease the pain. But you were awfully aware that death at the very moment was as unreachable as your god-forsaken mission."

# game/scripts/route1.rpy:197
translate english route1_start_877f8700:

    # ahe "呃啊——！"
    ahe "Ahhh—!"

# game/scripts/route1.rpy:200
translate english route1_start_b58ee839:

    # ahe "你刚刚...是不是对我做了非常不得了的事情。"
    ahe "Did you...did you just do something atrocious to me?"

# game/scripts/route1.rpy:202
translate english route1_start_a41ace7f:

    # ahe "呃...所以我们为什么在这里？"
    ahe "Uhhh...so why are we here?"

# game/scripts/route1.rpy:203
translate english route1_start_4359be3a:

    # wangshuang "这可是你说要来的。"
    wangshuang "Hey, it was you who wanted to come."

# game/scripts/route1.rpy:204
translate english route1_start_65c3bd1f:

    # ahe "那我要走了。"
    ahe "Then I'm leaving."

# game/scripts/route1.rpy:205
translate english route1_start_4fa81a93:

    # wangshuang "我们刚坐下诶，你要去哪儿？"
    wangshuang "Huh? We literally just sat down. Where're you going?"

# game/scripts/route1.rpy:206
translate english route1_start_0b066378:

    # ahe "不知道，要离开这里就是了。"
    ahe "Don't know. But I need to get outta here."

# game/scripts/route1.rpy:207
translate english route1_start_a4a21e4d:

    # ahe "...能麻烦开一下门吗？"
    ahe "...Hey could you open the door for me please?"

# game/scripts/route1.rpy:210
translate english route1_start_94d1bf9a:

    # ahe "好吧...你好，能帮我把门开一下吗？"
    ahe "Fine...Hi, could you please open the door for me?"

# game/scripts/route1.rpy:211
translate english route1_start_d2d3600c:

    # wangshuang "不好意思啊先生，老板刚才说了，今天店里的客人都必须留到天黑之后才能走。"
    wangshuang "My apologies, sir. The shop owner said that all customers must stay until sunset."

# game/scripts/route1.rpy:213
translate english route1_start_873fa68c:

    # wangshuang "老板说，还不够黑。"
    wangshuang "The boss said it's not dark enough."

# game/scripts/route1.rpy:214
translate english route1_start_26b1537a:

    # ahe "好吧...所以我能走了吗？"
    ahe "Fine...so can I go now?"

# game/scripts/route1.rpy:215
translate english route1_start_09548a01:

    # wangshuang "不能。"
    wangshuang "Nope."

# game/scripts/route1.rpy:216
translate english route1_start_6d7031a2:

    # ahe "你好烦。"
    ahe "You are so damn annoying."

# game/scripts/route1.rpy:218
translate english route1_start_638bda09:

    # wangshuang "就算出去了，你准备做什么？"
    wangshuang "What do you plan to do once getting out?"

# game/scripts/route1.rpy:219
translate english route1_start_c949d986:

    # ahe "把大石头推上山，把琴弦拧成电缆，什么都可以。"
    ahe "I donno. Shove a rock up a mountain, or wire up guitar strings into power lines, anything goes."

# game/scripts/route1.rpy:220
translate english route1_start_7a84a7ec:

    # wangshuang "意思是你准备换个地方无所事事。"
    wangshuang "In other words, doing nothing."

# game/scripts/route1.rpy:221
translate english route1_start_c406b70a:

    # ahe "再无所事事都胜过和你呆在这里。"
    ahe "Much better than being stuck here with you."

# game/scripts/route1.rpy:223
translate english route1_start_71ddcde1:

    # wangshuang "啊，已经这么遭人嫌了么..."
    wangshuang "Oh my, certainly didn't expect this bad name for myself."

# game/scripts/route1.rpy:224
translate english route1_start_a1bc16ee:

    # ahe "...多少有点自知之明吧你..."
    ahe "You know what you've done."

# game/scripts/route1.rpy:228
translate english route1_start_a54167b0:

    # wangshuang "不，区别在于我做到了，而你没有。"
    wangshuang "The real difference is, I got what I wanted, and you didn't."

# game/scripts/route1.rpy:231
translate english route1_start_f893d273:

    # wangshuang "而你拒绝与我共处一室的真正原因只是嫉妒，仅此而已。"
    wangshuang "And the sole reason you refuse to get stuck here with me is envy, and that's it."

# game/scripts/route1.rpy:232
translate english route1_start_184c8c36:

    # ahe "闭嘴吧..."
    ahe "Shut up..."

# game/scripts/route1.rpy:234
translate english route1_start_5ba9680b:

    # wangshuang "我闭嘴了又有什么用？难道你那苍白的“理想”就不需要人来陪葬了？"
    wangshuang 'So what if I did? Do you dare say that pale "dream" of yours needed no sacrifice?'

# game/scripts/route1.rpy:235
translate english route1_start_5e494470:

    # wangshuang "你为了尤里娅那小姑娘折断了多少人的骨头？阿鹤，狡辩是没有意义的，无论如何我们都是逝乐园覆灭的共犯。"
    wangshuang "How many bones did you break for that little girl Julia? Kaku, my man, there is no need to quibble. We are accomplices in destroying the PL District no matter how you look at it."

# game/scripts/route1.rpy:242
translate english route1_start_de45be2d:

    # wangshuang "所以不如放下成见，吃点团子，如何？"
    wangshuang "So why don't we drop the prejudice and have some mochi?"

# game/scripts/route1.rpy:246
translate english route1_start_fc8adc2c:

    # wangshuang "这就对了嘛，来都来了。"
    wangshuang "That's more like it. Eat up. Be my guest."

# game/scripts/route1.rpy:250
translate english route1_start_9ca6b8c7:

    # wangshuang "也许。"
    wangshuang "Maybe."

# game/scripts/route1.rpy:256
translate english route1_start_13ae7282:

    # ahe "别恶心我了，求你了。"
    ahe "Stop this shit, I beg you."

# game/scripts/route1.rpy:257
translate english route1_start_fd8a16ba:

    # wangshuang "你这人，连真心话都不让人说。"
    wangshuang "This guy! Won't even let me be honest."

# game/scripts/route1.rpy:261
translate english route1_start_2e29fb1a:

    # wangshuang "哦，对，团子有得是，千万别客气，请吧——"
    wangshuang "And eat up, make yourself at home, please——."

# game/scripts/route1.rpy:266
translate english route1_start_52637430:

    # ahe "明明刚说完不想我染上。"
    ahe "And you literally just said that you don't want me to get addicted."

# game/scripts/route1.rpy:284
translate english route1_start_31f374dc:

    # wangshuang "那可是正儿八经的人命啊喂！"
    wangshuang "My man, we are talking about life or death situation here!"

# game/scripts/route1.rpy:286
translate english route1_start_61e7517d:

    # ahe "所以我们要在这里待到什么时候？"
    ahe "I'll be looking forward to it, I guess. So how long will we be staying here?"

# game/scripts/route1.rpy:287
translate english route1_start_adda78fd:

    # wangshuang "等时机到了，自然就能离开。"
    wangshuang "When the time is ripe."

# game/scripts/route1.rpy:288
translate english route1_start_ea62222f:

    # ahe "也是一种较为朴素的过程？"
    ahe "Also a simple process?"

# game/scripts/route1.rpy:289
translate english route1_start_bd032688:

    # wangshuang "哦？如此简明且精确的定义，谁教你的？"
    wangshuang "Oh? Such a simple and elegant definition. Who taught you that?"

# game/scripts/route1.rpy:290
translate english route1_start_2a131aff:

    # ahe "一个傻逼。"
    ahe "A fucking dumbass."

# game/scripts/route1.rpy:292
translate english route1_start_0c6fc781:

    # wangshuang "{shake}好刻薄！{/shake}"
    wangshuang "So mean!"

# game/scripts/route1.rpy:293
translate english route1_start_163ac4ae:

    # ahe "像您这样有成就的大人物，只被骂傻逼还请偷着乐吧。"
    ahe "For an accomplished individual such as yourself, you should feel fortunate when you are merely called a fucking dumbass."

# game/scripts/route1.rpy:294
translate english route1_start_1b2eff34:

    # wangshuang "所以确实没法放过我了吗？"
    wangshuang "So is there really no way to let me off the hook?"

# game/scripts/route1.rpy:295
translate english route1_start_1f774a1b:

    # ahe "你还需要人放过？"
    ahe "Didn't know that you need this kind of vindication."

# game/scripts/route1.rpy:297
translate english route1_start_c8d3daed:

    # wangshuang "当然，我又不是没有罪恶感的人。"
    wangshuang "Of course, it's not like I don't feel guilty."

# game/scripts/route1.rpy:298
translate english route1_start_d67c38e0:

    # ahe "存疑。"
    ahe "Questionable."

# game/scripts/route1.rpy:299
translate english route1_start_b464a6e3:

    # wangshuang "哎阿鹤，虽然有些事情我确实做得...不太好...从世俗意义上来说，但也没必要这样质疑我演戏的质量嘛。"
    wangshuang "Kaku my man, I know that I was slightly fucked up in my way of doing things, by the normal standards. But please don't question my acting ability like that, if that's ok with you."

# game/scripts/route1.rpy:300
translate english route1_start_001136e3:

    # ahe "你看，你都自首了。还不逮捕你自己。"
    ahe "Well now that you've turned yourself in, why not arrest yourself?"

# game/scripts/route1.rpy:302
translate english route1_start_4cdcd63d:

    # wangshuang "那我还得兼任检察官辩护律师和法官，太麻烦了。"
    wangshuang "Then I'd have to also be the prosecutor and the judge. Too much of a nuisance."

# game/scripts/route1.rpy:303
translate english route1_start_2115e737:

    # ahe "用来消磨时间正合适，反正用不完。"
    ahe "Isn't it perfect to kill time with? Since we have unlimited servings."

# game/scripts/route1.rpy:304
translate english route1_start_3adaf3f9:

    # wangshuang "不不不那就不对了，如果你还想“消磨时间”，那就说明你修为尚浅，还没悟透其中道理。"
    wangshuang "That's shallow. If you are still trying to kill time, that means the Dao is still evading you. You need to think deeper."

# game/scripts/route1.rpy:305
translate english route1_start_21dc4eff:

    # ahe "...好的，师傅。"
    ahe "Yes yes sensei."

# game/scripts/route1.rpy:306
translate english route1_start_0b3bcaf1:

    # ahe "话说师傅，你手里拿的是什么？"
    ahe "By the way, what's that thing you're holding?"

# game/scripts/route1.rpy:307
translate english route1_start_cc8659bd:

    # wangshuang "哦，这个？不是什么重要的东西，但你可以尝尝看。"
    wangshuang "This? Nothing too important, but if you want, you can taste it."

# game/scripts/route1.rpy:308
translate english route1_start_126b2522:

    # ahe "尝尝看？"
    ahe "Taste it?"

# game/scripts/route1.rpy:309
translate english route1_start_e3ff3ec6:

    # wangshuang "对啊，吃的。要不要试试？"
    wangshuang "Yea, wanna try?"

# game/scripts/route1.rpy:312
translate english route1_start_11fdb519_2:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/route1.rpy:314
translate english route1_start_fdfdf3e7:

    # "阿霜手里把玩的那物件，你之前肯定见过，却想不起任何细节。"
    "You had definitely seen that thing Shuang was toying with before, but couldn't recall a single detail about it."

# game/scripts/route1.rpy:315
translate english route1_start_ee0b3205:

    # "总之没想到竟是一件吃食。"
    "Hard to believe it was actually food, of all things."

# game/scripts/route1.rpy:323
translate english route1_start_95f17193:

    # "你接过王霜手里那无色透明的多面体。"
    "You took that translucent polyhedron from Shuang's hand."

# game/scripts/route1.rpy:324
translate english route1_start_85233ed2:

    # "那东西轻若无物又变幻莫测，看似是固体，摸起来却又有介于凝胶和麻薯之间的质感，躺在你手心里，冰冰凉的。"
    "The object was light. Despite having a rigid look, it had a texture between gel and mochi. Your palm felt chilly holding it."

# game/scripts/route1.rpy:331
translate english route1_start_8f82eae1:

    # ahe "蓝色啊，怎么了？"
    ahe "Blue. What about it?"

# game/scripts/route1.rpy:332
translate english route1_start_e07862fe:

    # wangshuang "你看——"
    wangshuang "Look around you."

# game/scripts/route1.rpy:341
translate english route1_start_c96f194f:

    # split_left_narrator "你正摸不着头脑，转眼间却发现了周遭惊人的变故——四周逐渐泛起蓝色、波浪状的纹理，很快侵蚀了整个视野。"
    split_left_narrator "You were in a daze before noticing the baffling change of scenery around you - blue wavy textures started to dance around you, and they quickly eroded your entire field of view."

# game/scripts/route1.rpy:342
translate english route1_start_23e370bf:

    # extend "\n你反倒比先前要更加冷静，又低头吃了几口团子。甜腻腻的滋味在口腔中涟漪般散开，每颗味觉细胞都在欣喜若狂地发送着饱足的信号。"
    extend "\nYou somehow felt a bit calmer than before, taking a few more bites from the mochi as if everything was meant to be. The sweet, sugary taste rippled in your palate. Every cell was frantically sending out signals to declare their satedness."

# game/scripts/route1.rpy:343
translate english route1_start_c3b4af85:

    # split_right_narrator "甜味的颜色？金黄的莓红的草绿的深棕的，味觉的色彩洪流汇入弥漫在整个视觉空间的海蓝色波浪中。"
    split_right_narrator "The color of the sweetness? Golden raspberry-red grassy green deep brown, the torrent of gastronomic pigments gathered and quickly filled up the oceanic waves around you."

# game/scripts/route1.rpy:344
translate english route1_start_c0349ea7:

    # extend "\n你抬头望向王霜，她也望着你，脸上含蓄地挂了一抹邪魅的笑容，眼神里却又流露出一丝欣慰，仿佛望着一个迷路的孩子。"
    extend "\nYou looked up to Shuang. She looked at you as well, with a subtle, seductive, yet reassuring smile on her face, as if looking caringly at a lost child."

# game/scripts/route1.rpy:345
translate english route1_start_fcb426e2:

    # extend "\n她略卷的水蓝色长发在周身空间的波浪里散着，勾勒出洋流的轮廓。"
    extend "\nHer curly blue hair danced freely in the azure waving space, sketching out the shape of the currents."

# game/scripts/route1.rpy:348
translate english route1_start_ab630ba9:

    # split_left_narrator "你心中对她海啸般的戒心早已荡然无存了——你几乎有些喜欢她现在的样子，宛如一个母亲，又像是神明，给视野不断抹上温柔的蓝色。"
    split_left_narrator "Your raging alert towards her was no more - you almost liked how she looked, like a mother, and a goddess, continuously painting your vision blue."

# game/scripts/route1.rpy:349
translate english route1_start_c062b210:

    # extend "\n每一缕神经都在扩张。启示性的景象。时间和空间波浪。无孔不入的色彩和甜味。蓝色的。交响。"
    extend "\nEvery thread of nerve was expanding. An illuminating moment. Time and space waving. Colors and sweetness seeped into everything. Blue. Symphony."

# game/scripts/route1.rpy:350
translate english route1_start_dc5bb5c4:

    # split_right_narrator "反复咀嚼伤痛直至淡而无味，直到甜味凭空冒出来。"
    split_right_narrator "Kept chewing on painful memories until it tasted bland, until sweetness came out of nowhere."

# game/scripts/route1.rpy:351
translate english route1_start_07e40fd2:

    # extend "\n在一切都已结束的当下，连时间都已丧失价值，唯一还能让你睁开双眼的，就只有——"
    extend "\nAt the current moment when everything has ended, the only thing that could keep you awake was:"

# game/scripts/route1.rpy:354
translate english route1_start_b455edb0:

    # centered_large_narrator "瘾。"
    centered_large_narrator "Addiction."

# game/scripts/route1.rpy:361
translate english route1_start_a181071c:

    # split_left_narrator "王霜的微笑越发邪魅——她逐渐成为了一个微笑。"
    split_left_narrator "Shuang's smile was getting more devilishly charming - she started to turn into a smile."

# game/scripts/route1.rpy:363
translate english route1_start_3d70cb46:

    # extend "\n渴望的源头冲动的源头向往的源头发现了。"
    extend "\nThe source of all urges and wants has been found!"

# game/scripts/route1.rpy:364
translate english route1_start_f68928e4:

    # split_right_narrator "浪潮般的甜味反复沁入意识。她开始微笑。她停止微笑。目光所及之处就能看见她的微笑。"
    split_right_narrator "Rippling sweetness kept eroding your thoughts and consciousness. She started smiling. Then she stopped. Everywhere you looked, you saw her face. And her smile."

# game/scripts/route1.rpy:367
translate english route1_start_b5db51a6:

    # split_left_narrator "燥热使得意识模糊，痛苦消减。鼓的声音。恒久的鼓声从背景里逐渐浮现，强烈起来，震耳欲聋，每一击都与心跳同调。"
    split_left_narrator "The scorching consciousness became blurry by the second, as all your pain faded away. The sound of beating drums. The sound of perpetually beating drums emerged from the background, and kept getting louder, and louder, and deafeningly loud. Every beat matched that of your heart."

# game/scripts/route1.rpy:368
translate english route1_start_fdccfc4f:

    # extend "\n在这暧昧混沌里，你感到安逸。"
    extend "\nIn the middle of this subtly intimate chaos, you felt at home."

# game/scripts/route1.rpy:369
translate english route1_start_cffa842a:

    # extend "\n这样就够了。"
    extend "\nThat would be enough."

# game/scripts/route1.rpy:372
translate english route1_start_a686e72f:

    # wangshuang "说到底，我们所做的一切也只是为了满足癖好而已。"
    wangshuang "After all, all we did was just to satisfy our fetishes."

# game/scripts/route1.rpy:373
translate english route1_start_3a36f7cd:

    # ahe "这大概是一件无可厚非的事情。"
    ahe "I guess that's not that big of a deal."

# game/scripts/route1.rpy:375
translate english route1_start_67324e54:

    # wangshuang "大概吧。也许那就是所有人的使命。"
    wangshuang "Maybe. Maybe that's the mission of everyone."

# game/scripts/route1.rpy:376
translate english route1_start_6adac02b:

    # wangshuang "如此轻浮如此下作，如此美妙。"
    wangshuang "So very frivolous and profane, so very beautiful."

# game/scripts/route1.rpy:377
translate english route1_start_d6b82585:

    # ahe "如此轻而易举。"
    ahe "So simple and dumb."

# game/scripts/route1.rpy:378
translate english route1_start_86e9194d:

    # wangshuang "如此唾手可得。"
    wangshuang "So within arm's reach."

# game/scripts/route1.rpy:380
translate english route1_start_b996a16c:

    # ahe "我想要..."
    ahe "I wish to..."

# game/scripts/route1.rpy:383
translate english route1_start_11fdb519_3:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/route1.rpy:386
translate english route1_start_2a34d27e:

    # ahe "我想要就这样继续下去。"
    ahe "I want to continue like this."

# game/scripts/route1.rpy:389
translate english route1_start_1c6b0108:

    # ahe "我困了。"
    ahe "I'm tired."

# game/scripts/route1.rpy:397
translate english route1_start_a0255056:

    # large_narrator "更多思绪已无意义，一如时间。"
    large_narrator "Any more thoughts would just be a waste of time, just like time itself."

# game/scripts/route1.rpy:399
translate english route1_start_f3e3299d:

    # extend "\n一切都是许可的，这样的冲动从未如此强烈过。"
    extend "\nEverything was permissible. This urge has never been so strong."

# game/scripts/route1.rpy:400
translate english route1_start_bca551d4:

    # extend "\n你迫切地想要伸出手，但双臂已经先你一步向前伸了出去，贪婪地揉捏着冰凉而柔顺的空气，水蓝色的空气。"
    extend "\nYou wanted to reach out your hands, but your hands reached out before your thoughts took shape, rapaciously feeling the chilly and silky air. Azure air."

# game/scripts/route1.rpy:403
translate english route1_start_90bf544c:

    # large_narrator "更深的见解就隐藏其中，因为一切都是许可的，视野中的所有事物都是从始至终连贯而统一的，如此怡人，如此饱满。"
    large_narrator "Deeper insights must have been hidden within, because everything was permissible. Everything in your field of view was consistent and continuous. So very pleasant, so very full."

# game/scripts/route1.rpy:404
translate english route1_start_c3e6e848:

    # extend "\n人类的智识自然无力探寻其中奥秘，但在王霜无处不在的笑容辉耀之下，你的一部分认知已踏入了更深层的水域。"
    ahe "Those were insights clearly not meant for average human intellect to consume. But with Shuang's omnipresent grin shining on your cerebral cortex, your mental capacity had tapped into deeper waters."

# game/scripts/route1.rpy:405
translate english route1_start_ae8d16d4:

    # extend "\n越向深处就越被不可知所掣肘，当眼前的色彩开始回旋，你意识到或许梦境的另一面并非现实，而是某种更加完整且怖人的造物。"
    extend "\nThe deeper, the more bounded by the unknowable. When the colors started to swirl before your very eyes, you realized that maybe the counterpart to dreams was not the reality, but something more complete and horrifying."

# game/scripts/route1.rpy:413
translate english route1_start_6f995df5:

    # extend "\n但你已经满足了，由内而外地满足了，在饱满的感官刺激中感到一阵——疲劳？"
    extend "\nBut you were already satisfied, thoroughly satisfied. You felt a bit...tired...from the endless cognitive stimulation."

# game/scripts/route1.rpy:414
translate english route1_start_4deb13a1:

    # extend "\n幸福的疲劳、优质的疲劳、苦苦追寻的疲劳、允许你在辗转反侧后终于入睡的甜美疲劳。"
    extend "\nPleasant fatigue, high-quality fatigue, sought-after fatigue, the fatigue that would allow you to finally rest after staying up forever."

# game/scripts/route1.rpy:417
translate english route1_start_ee2dc45a:

    # large_narrator "世界空无一人，因为任何个体都不具备足够的差异能够让它们自称“存在”，因此你将它们尽数吞下，如同团子。"
    large_narrator 'The world was empty. Because there wasn\'t a single soul that had enough distinction from another to call themselves "existing". So you swallowed all of them, like mochi.'

# game/scripts/route1.rpy:418
translate english route1_start_fd37b955:

    # extend "\n糖分继续满溢出来，沿着你存在的边缘缓缓淌下，坠入周身蔚蓝的虚空之中，粘稠而香甜。"
    extend "\nThe sugar continued to surge, dripping down from the fringe of your existence, falling into the azure abyss around you, sticky and delicious."

# game/scripts/route1.rpy:419
translate english route1_start_9042c8e5:

    # extend "\n糖浆，万物的粘合剂。就用它来替代血液。"
    extend "\nSyrup, the universal glue, let's replace our blood with it!"

# game/scripts/route1.rpy:420
translate english route1_start_f16a30f2:

    # extend "\n完成之后就去睡吧。"
    extend "\nAnd go to sleep afterwards."

# game/scripts/route1.rpy:421
translate english route1_start_647c55b3:

    # extend "\n你的愿望在那念头浮出水面的瞬间便成为了现实，而你只想在这静谧安详的世界里睡去。"
    extend "\nYour wish came true the moment it emerged, as you headed towards a deep, endless slumber."

# game/scripts/route1.rpy:425
translate english route1_start_9254ee90:

    # large_narrator "然而当你行将合眼时，一阵强烈的恶心自胃里上涌，就像有人抓住你的肠胃，自下而上地用力挤压。"
    large_narrator "But it wasn't so easy. As you were closing your eyes for good, a crippling nausea took over your entire body, as if someone was squeezing your innards from bottom up."

# game/scripts/route1.rpy:426
translate english route1_start_6b22df3c:

    # extend "\n警告：过热。过热。"
    extend "\nWARNING: OVERHEAT. OVERHEAT."

# game/scripts/route1.rpy:427
translate english route1_start_5797dab3:

    # extend "\n钟表嘀嗒作响。"
    extend "\nClocks were ticking."

# game/scripts/route1.rpy:429
translate english route1_start_6aba3fbc:

    # extend "\n和你所熟知的呕吐不同，你吐出的只有色彩。"
    extend "\nBut all you threw up was color."

# game/scripts/route1.rpy:438
translate english route1_start_8bb2621e:

    # large_narrator "你感到疲惫不堪，只想回到一个更加清醒的地方。"
    large_narrator "You felt nothing but tired. All you wanted was to return to somewhere more sober."

# game/scripts/route1.rpy:441
translate english route1_start_a2a7134d:

    # extend "\n空空如也的店里坐着空空如也的你。"
    extend "\nIn the empty shop sat an empty you."

# game/scripts/route1.rpy:450
translate english route1_start_da521da6:

    # extend "\n更多裂痕。"
    extend "\nMore cracks."

translate english strings:

    # game/scripts/route1.rpy:23
    old "不对劲..."
    new "Sick..."

    # game/scripts/route1.rpy:25
    old "很有精神！"
    new "Bright and shiny!"

