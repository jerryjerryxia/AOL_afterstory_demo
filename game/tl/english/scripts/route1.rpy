    # game/scripts/route1.rpy:20
    old "不对劲..."
    new "Sick..."

    # game/scripts/route1.rpy:22
    old "很有精神！"
    new "Bright and shiny!"

    # game/scripts/route1.rpy:54
    old "疯了..."
    new "Going insane..."

    # game/scripts/route1.rpy:56
    old "睡着了。"
    new "Falling asleep."

