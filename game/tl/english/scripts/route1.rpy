    # wangshuang "啊啊呐唔一握艾鈤——..."
    wangshuang "Aa anna wu ii oh ai rrh——..."

# game/scripts/route1.rpy:1025
translate english route1_start_752b5ba5:

    # wangshuang "唵椅迩唵毋炆戊囮吔坳唔岙莪。"
    wangshuang "Onneeerhonnwoowennerryehaongoarh."

# game/scripts/route1.rpy:1028
translate english route1_start_114ee37d:

    # ahe "阿霜，你还好吗？"
    ahe "Shuang, are you all right?"

# game/scripts/route1.rpy:1030
translate english route1_start_1b79ebd1_1:

    # wangshuang "嗯？怎么了？"
    wangshuang "What's up?"

# game/scripts/route1.rpy:1031
translate english route1_start_811cbe3f:

    # ahe "你刚才...当我没说。所以为什么头骨不存在？"
    ahe "Just now you...forget it. So why doesn't the skull exist?"

# game/scripts/route1.rpy:1033
translate english route1_start_2ccaa9c9:

    # wangshuang "因为我看不见。"
    wangshuang "Because I can't see it."

# game/scripts/route1.rpy:1034
translate english route1_start_4dad93b8:

    # ahe "啊？"
    ahe "Huh?"

# game/scripts/route1.rpy:1042
translate english route1_start_53153f19:

    # wangshuang "一焱髻暨戊馹曳葳邑吖霭肮毐峪镍醪！"
    wangshuang "Iiyannjiijiioorzhyehweiihahaiangmmyunielao!"

# game/scripts/route1.rpy:1043
translate english route1_start_aa4055ab:

    # ahe "喂...阿霜你又——"
    ahe "Hey...Shuang, you're doing it ag——"

# game/scripts/route1.rpy:1049
translate english route1_start_1450de86:

    # ahe "什——"
    ahe "Wha——"

# game/scripts/route1.rpy:1052
translate english route1_start_cbb91614:

    # youliya "你好，阿鹤。"
    youliya "Hello, Kaku."

# game/scripts/route1.rpy:1053
translate english route1_start_b31da539:

    # ahe "诶？你——"
    ahe "Huh? You——"

# game/scripts/route1.rpy:1054
translate english route1_start_673bca22:

    # youliya "嗯，我当然还活着。"
    youliya "Mm. Of course I'm still alive."

# game/scripts/route1.rpy:1055
translate english route1_start_88d8a980:

    # ahe "可是...可是我..."
    ahe "But...but I..."

# game/scripts/route1.rpy:1059
translate english route1_start_9ab74ffc:

    # youliya "你豋炅宓恇蠹璱钅飰棏巠敪玸——"
    youliya "Yuudengjyymihkwangduuserjinfannderjingduosyy——"

# game/scripts/route1.rpy:1060
translate english route1_start_1984696e:

    # ahe "啊...等等...等一下！"
    ahe "Ah...wait...wait a second!"

# game/scripts/route1.rpy:1062
translate english route1_start_35e69190:

    # youliya "嗯，又失忆了么...离我们上次分别也没过多久吧，阿鹤？"
    youliya "Mm, lost your memory again, huh...it hasn't been that long since we said goodbye, has it, Kaku?"

# game/scripts/route1.rpy:1063
translate english route1_start_e6ae1e17:

    # ahe "不是...尤里娅...不对..."
    ahe "No...Julia...that's not right..."

# game/scripts/route1.rpy:1067
translate english route1_start_b6272e3a:

    # youliya "喔，确实是不太对——。"
    youliya "Oh, it certainly isn't right——."

# game/scripts/route1.rpy:1071
translate english route1_start_3df3bfeb:

    # ahe "尤里娅，尤里娅？"
    ahe "Julia, Julia?"

# game/scripts/route1.rpy:1075
translate english route1_start_26d4543e:

    # wangshuang "飒炟曠莩皎靸礚睫覅是否解释你的诨涤？"
    wangshuang "Saadaakwangfuujyaosaakerjyefei - care to account for your muddlement?"

# game/scripts/route1.rpy:1076
translate english route1_start_b16d67d5:

    # ahe "啊...你们...你们...等等..."
    ahe "Ah...you two...you two...wait..."

# game/scripts/route1.rpy:1080
translate english route1_start_62578411:

    # ahe "呃...啊...可是...可是..."
    ahe "Uh...ah...but...but..."

# game/scripts/route1.rpy:1082
translate english route1_start_f60eddba:

    # youliya "但那对你来说根本不重要吧，毕竟都是最后关头了，无论怎样都不能输给一群杰罗瓦控制的假人嘛！尤其那些东西只是长得和我一样而已，根本不需要任何同情。"
    youliya "None of it mattered to you though, did it. It was your final stretch after all. Can't lose to a crowd of puppets Jerowald was running, whatever it took, right? Especially when those things only wore my face. Nothing there to pity."

# game/scripts/route1.rpy:1083
translate english route1_start_e11e13bb:

    # youliya "只要你“看到”那些东西不是“我”，自然就可以随手杀掉了——一切都顺理成章，无可厚非，对吧？"
    youliya "Once you 'see' that they aren't 'me', killing them costs you nothing - everything tracks, perfectly reasonable, right?"

# game/scripts/route1.rpy:1086
translate english route1_start_8f65a428:

    # youliya "可是阿鹤，你知道吗？所有复制体的感官都会回流到我的身体。"
    youliya "But did you know, Kaku? Every copy's sensation run back into my body."

# game/scripts/route1.rpy:1087
translate english route1_start_91cd74a4:

    # ahe "尤里娅...这不是——"
    ahe "Julia...that's not——"

# game/scripts/route1.rpy:1088
translate english route1_start_143538c5:

    # youliya "每根断掉的骨头、每滴流出来的血、每副碎掉的内脏——虽然对我来说这些痛苦并不真实，可那体验还是让我记忆犹新啊，每一次死掉。"
    youliya "Every bone that snapped, every drop of blood that ran out, every organ that burst - none of that pain was real to me. But the experience was. I remember all of it. Every single time I died."

# game/scripts/route1.rpy:1090
translate english route1_start_94e4e86f:

    # youliya "死掉诶...那就是你口中的“无法重复的深邃体验”吧。能连续体验那么多次，我是不是该...感谢你呢？"
    youliya "Dying. That must be what you call the 'profound experience that can never be repeated'. I got it over and over. Shouldn't I...thank you for that?"

# game/scripts/route1.rpy:1093
translate english route1_start_ce7b97cd:

    # youliya "那么作为你的谢礼，让我来告诉你一点浅显的事实吧。"
    youliya "So here's your thank-you gift. A few plain facts."

# game/scripts/route1.rpy:1095
translate english route1_start_7b20c77d:

    # youliya "阿鹤哥，在逝乐园终结的前几天里，不只你自己，连你身边的大家，所有人都在演戏哦：我、王霜、米姐，全都一样。"
    youliya "In the last few days before the PL District ended, it wasn't only you who were pretending, Kaku. Everyone around you was. Me, Wang Shuang, Sister Mi. All of us."

# game/scripts/route1.rpy:1097
translate english route1_start_d5494866:

    # youliya "你是不是觉得，只要强撑着送我离开了逝乐园，你就能得到解脱了？"
    youliya "Did you think that if you held yourself together long enough to get me out of the PL District, you'd be let off?"

# game/scripts/route1.rpy:1098
translate english route1_start_e425b2fa:

    # ahe "——！"
    ahe "...!"

# game/scripts/route1.rpy:1099
translate english route1_start_c29ac4e4:

    # youliya "你是不是觉得，只要抛下你所拥有的一切，最可怕的下场无非就是死掉而已？"
    youliya "Did you think that if you gave up everything you had, the worst waiting for you was death?"

# game/scripts/route1.rpy:1100
translate english route1_start_ed59130b:

    # youliya "你是不是以为，只要假惺惺地承担起所有人的痛苦，你就能满足你那跳出日常的冲动了？"
    youliya "Did you imagine that shouldering everyone's pain would finally scratch that itch of yours to escape from your mundane life?"

# game/scripts/route1.rpy:1102
translate english route1_start_3e49e6d3:

    # youliya "完全不动脑子就接受这样的结论，简直是错得不能再错了啊，我一败涂地的救世主先生。"
    youliya "Swallowing a conclusion like that without once using your head - you could not be more wrong, my pathetic Mr. Savior."

# game/scripts/route1.rpy:1104
translate english route1_start_decc4293:

    # youliya "那么——请见证你愚行真正的后果吧。"
    youliya "So then - come and witness the real consequences of your ignorance."

# game/scripts/route1.rpy:1113
translate english route1_start_7c33d892:

    # ahe "——么！！！"
    ahe "——t!!!"

# game/scripts/route1.rpy:1114
translate english route1_start_5457cd36:

    # shishou "阿鹤，事到如今你又在害怕什么呢？这可是你亲手拼出来的身子哦。"
    shishou "Kaku, what's there to be afraid of? You put this body together with your own hands."

# game/scripts/route1.rpy:1115
translate english route1_start_3b637747:

    # ahe "啊...啊啊啊啊...啊啊啊啊啊啊啊啊啊啊——"
    ahe "Ah...aaaahhh...aaaaaaaaaaahhhh——"

# game/scripts/route1.rpy:1117
translate english route1_start_5dbeb5f7:

    # wangshuang "别跑啊，这可是你们的感人重逢诶！"
    wangshuang "Don't run! This is your heart-warming reunion!"

# game/scripts/route1.rpy:1118
translate english route1_start_39085aac:

    # ahe "别过来！"
    ahe "Stay back!"

# game/scripts/route1.rpy:1119
translate english route1_start_975d35c3:

    # shishou "阿鹤，我们还没聊完——"
    shishou "Kaku, we weren't finished——"

# game/scripts/route1.rpy:1120
translate english route1_start_061d569f:

    # ahe "你别过来！！！"
    ahe "Stay away from me!!!"

# game/scripts/route1.rpy:1123
translate english route1_start_c7241a86:

    # ahe "这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的这不是真的！"
    ahe "None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real None of this is real!"

# game/scripts/route1.rpy:1125
translate english route1_start_e18ffbb5:

    # wangshuang "阿鹤？"
    wangshuang "Kaku?"

# game/scripts/route1.rpy:1126
translate english route1_start_ff7c5340:

    # ahe "啊——！你为什么还在这里！"
    ahe "Agh——! Why are you still here!"

# game/scripts/route1.rpy:1128
translate english route1_start_3bc34203:

    # wangshuang "我当然在啦，她也还在——"
    wangshuang "Of course I'm here. So is she——"

# game/scripts/route1.rpy:1129
translate english route1_start_69eab577:

    # shishou "哈喽~"
    shishou "Hello~"

# game/scripts/route1.rpy:1130
translate english route1_start_e60beb82:

    # ahe "别过来！你别过来！再见！"
    ahe "Stay back! Get away from me! Goodbye!"

# game/scripts/route1.rpy:1134
translate english route1_start_682a88e5:

    # ahe "啊...保持呼吸...保持呼吸...保持呼吸...保持呼吸..."
    ahe "Ah...keep breathing...keep breathing...keep breathing...keep breathing..."

# game/scripts/route1.rpy:1135
translate english route1_start_9d8e3ab3:

    # shishou "你好。"
    shishou "Hello."

# game/scripts/route1.rpy:1138
translate english route1_start_d3154b0c:

    # wangshuang "这就跑不动了？"
    wangshuang "Out of legs already?"

# game/scripts/route1.rpy:1139
translate english route1_start_4a304f72:

    # ahe "...不要...过来..."
    ahe "...Don't...come closer..."

# game/scripts/route1.rpy:1140
translate english route1_start_3730d9bc:

    # wangshuang "要知道，你可是自愿来到这里的哦。"
    wangshuang "You came here of your own free will, you know."

# game/scripts/route1.rpy:1141
translate english route1_start_5d44f0bc:

    # shishou "嗯。"
    shishou "Mm."

# game/scripts/route1.rpy:1142
translate english route1_start_b21be4b6:

    # ahe "我...一定...要...离开这里！"
    ahe "I...have to...get out...of here!"

# game/scripts/route1.rpy:1144
translate english route1_start_f8a04f0e:

    # wangshuang "阿鹤啊，你倒是冷静下来仔细想想，你费了这么大力气把她拼凑出来，可当她真正活过来之后又无法直视她了？"
    wangshuang "Kaku. Sit down and think it through. All that work putting her together, and now she's actually up and walking you can't stand to look at her?"

# game/scripts/route1.rpy:1145
translate english route1_start_c66c32b2:

    # ahe "这不是我想要的..."
    ahe "This isn't what I wanted..."

# game/scripts/route1.rpy:1147
translate english route1_start_fff27fbf:

    # wangshuang "只因为她身子不完整？"
    wangshuang "All because the body's incomplete?"

# game/scripts/route1.rpy:1148
translate english route1_start_89dfef1c:

    # ahe "这不是我想要的！"
    ahe "This isn't what I wanted!"

# game/scripts/route1.rpy:1150
translate english route1_start_48554ff6:

    # wangshuang "那就把头埋进沙子里啊，那样你就什么都不用看了。"
    wangshuang "Then put your head in the sand. That way you don't have to look at anything."

# game/scripts/route1.rpy:1151
translate english route1_start_93fd9d4a:

    # ahe "呃...啊——对不起——"
    ahe "Ugh...ah——I'm sorry——"

# game/scripts/route1.rpy:1162
translate english route1_start_d31e5e9f:

    # large_narrator "沙地冰凉而干燥，在这个无声的世界里，你艰难地呼吸。"
    large_narrator "The sand was cool and dry. In that soundless world you dragged in what air you could."

# game/scripts/route1.rpy:1163
translate english route1_start_5cad8479:

    # extend "\n随着恐惧略微消散，你察觉到这地下似乎不像想象中那样黑暗，便试探性地睁开双眼，但立刻后悔了，因为你见到了比地面上那无头尸首更加令人绝望的恐怖——"
    extend "\nAs the fear thinned, you realized it wasn't as dark down here as you'd assumed. You opened your eyes and regretted it at once - what was down here was worse than the headless thing above ground——"

# game/scripts/route1.rpy:1164
translate english route1_start_1284d296:

    # extend "\n沙砾。"
    extend "\nSand."

# game/scripts/route1.rpy:1165
translate english route1_start_249836e9:

    # extend "\n满眼都是沙砾。但只消稍稍细看，那一颗颗的，分明就不是沙砾。"
    extend "\nNothing but sand. Except look a little closer and every grain of it plainly wasn't sand at all."

# game/scripts/route1.rpy:1172
translate english route1_start_65ef23bb:

    # large_narrator "每颗“沙砾”都是一颗无色透明多面体。"
    large_narrator "Every 'grain' was a colorless, translucent polyhedron."

# game/scripts/route1.rpy:1173
translate english route1_start_4680f28b:

    # extend "\n而每颗多面体里，都有一颗泛着血丝的眼珠。"
    extend "\nAnd in every polyhedron sat an eyeball, threaded through with blood."

# game/scripts/route1.rpy:1174
translate english route1_start_b9910a04:

    # extend "\n随着那些眼珠在你视野里逐渐清晰，它们似乎也注意到了你的存在。"
    extend "\nAs the eyeballs came clear in your sight, they seemed to notice you, too."

# game/scripts/route1.rpy:1175
translate english route1_start_b6349886:

    # extend "\n无数锥子般的目光将你刺得千疮百孔。"
    extend "\nCountless stares went through you like awls and left you riddled with holes."

# game/scripts/route1.rpy:1180
translate english route1_start_2f7d0be7:

    # large_narrator "你绝望地想要把头抽出来，但原本稀松的沙地此刻如钢钳一般将你的头死死扼住，任凭双手在沙地上狂乱地挥舞抓挠，也无法动摇分毫 。"
    large_narrator "You tried to wrench your head free. But the seemingly loose sand had now turned into a steel clamp around your neck, and however wildly your hands tore at the ground, it would not give an inch."

# game/scripts/route1.rpy:1181
translate english route1_start_8b64aeba:

    # extend "\n你只能眼睁睁看着那些布满血丝的眼珠朝你的脸逐渐聚拢，随后——"
    extend "\nSo you watched the bloodshot eyeballs crowd in toward your face, and then——"

# game/scripts/route1.rpy:1185
translate english route1_start_78450810:

    # large_narrator "它们一颗颗地在你眼前爆裂开来，里面迸发出浑浊的玻璃体与血液的混合物，飞溅到你脸上，温热而粘稠。"
    large_narrator "They burst, one after another, right in front of you - clouded vitreous fluid and blood blowing out and landing on your face, warm and thick."

# game/scripts/route1.rpy:1186
translate english route1_start_305c908b:

    # extend "\n所剩无几的空气中弥漫着你闻所未闻的诡异气味。那是尸体的味道，但其来源并非布满你颜面的异色粘液。"
    extend "\nWhat air was left carried a smell you had never met before. It's the stench of the corpse. And it wasn't coming from the slime running down your face."

# game/scripts/route1.rpy:1187
translate english route1_start_3b910ca7:

    # extend "\n几团大块的血污顺着你的脸颊缓缓滑下，留下一道道蜗牛足迹般亮晶晶的轨迹。"
    extend "\nThick clots of gore slid down your cheeks and left shining trails behind them, like snails."

# game/scripts/route1.rpy:1190
translate english route1_start_74b3b76a:

    # large_narrator "尸体的味道越发浓烈。"
    large_narrator "The corpse stench got stronger."

# game/scripts/route1.rpy:1191
translate english route1_start_36a45875:

    # extend "\n嘴唇也沾上了血污，怎奈双手与头颅天各一方，你无法想象如何在不扩大事态的前提下将嘴唇清理干净，只能强行忍受温热湿软的污物在唇上缓缓滑落的触感。"
    extend "\nIt had reached your lips. With your hands and your head in separate worlds there was no cleaning them without making it worse - you just had to take it, warm wet filth sliding slow across your mouth."

# game/scripts/route1.rpy:1192
translate english route1_start_8eeea220:

    # extend "\n你极力缩紧喉头，拼尽全力不哇地一声吐出来，但那念头很快就被另一种思绪所覆盖了。"
    extend "\nYou clamped your throat shut and fought with everything you had not to retch. But the thought was buried under another one soon enough."

# game/scripts/route1.rpy:1195
translate english route1_start_4e7d9468:

    # centered_large_narrator "你想——"
    centered_large_narrator "You wanted——"

# game/scripts/route1.rpy:1198
translate english route1_start_d4e6f08a:

    # large_narrator "尸体气味的浓度达到了顶峰。"
    large_narrator "The corpse stench reached its peak."

# game/scripts/route1.rpy:1199
translate english route1_start_de73b65d:

    # extend "\n你十分清楚那气味的来源，只是仍在试图移开目光，就像你一直以来所做的那样。"
    extend "\nYou knew exactly where it came from. You went on trying to look away, the way you always had."

# game/scripts/route1.rpy:1200
translate english route1_start_4a4f9ff0:

    # extend "\n但一直逃避的人终究会无路可逃。"
    extend "\nBut a man who keeps running would run out of ground eventually."

# game/scripts/route1.rpy:1201
translate english route1_start_3edd09dc:

    # extend "\n当人制造了过多的尸体，那他自己迟早也会步入其造物的行列。"
    extend "\nMake enough corpses and sooner or later you join them."

# game/scripts/route1.rpy:1202
translate english route1_start_a16d5d95:

    # extend "\n一阵遥远而熟悉的冲动自心底涌上来。"
    extend "\nSomething old and familiar came up from the bottom of you."

# game/scripts/route1.rpy:1203
translate english route1_start_ebacfb7a:

    # extend "\n你想死。"
    extend "\nYou wanted to die."

# game/scripts/route1.rpy:1208
translate english route1_start_afa6ff5f:

    # large_narrator "手心传来温热而粘稠的触感，你自然知道那是什么，于是开始用力甩手。"
    large_narrator "Your palms were warm and sticky. You knew what it was. You started shaking your hands frantically."

# game/scripts/route1.rpy:1209
translate english route1_start_60bc6b5f:

    # extend "\n但无论你怎么使劲，那事物仍旧纹丝不动地包裹着你整个手掌。"
    extend "\nHowever hard you shook, it stayed wrapped around them without shifting."

# game/scripts/route1.rpy:1210
translate english route1_start_bfd2864f:

    # extend "\n就像一副牢靠的手套。"
    extend "\nLike a glove that tightly fits."

# game/scripts/route1.rpy:1211
translate english route1_start_dd0b80b2:

    # extend "\n就像你的第二层皮肤。"
    extend "\nLike your second skin."

# game/scripts/route1.rpy:1216
translate english route1_start_b1df7673_1:

    # ahe "啊——！"
    ahe "Ahhh—!"

# game/scripts/route1.rpy:1217
translate english route1_start_08b3176e:

    # ahe "对不起...对不起...对不起..."
    ahe "I'm sorry...I'm sorry...I'm sorry..."

# game/scripts/route1.rpy:1224
translate english route1_start_74d60d6a:

    # large_narrator "口中不断重复着同样的三个音节，直到语言失去意义，只剩下干涩的空气波动无情地敲打你的耳膜。"
    large_narrator "Your mouth kept uttering the same three syllables until the words stopped meaning anything. All that was left was dry air beating on your eardrums."

# game/scripts/route1.rpy:1225
translate english route1_start_523be0d0:

    # extend "\n血液骨髓脂肪溢出来。脂肪明黄。胆汁墨绿。血液暗红。"
    extend "\nBlood and bone marrow and fat came out of it. The fat bright yellow. The bile dark green. The blood deep red."

# game/scripts/route1.rpy:1226
translate english route1_start_03ec51e0:

    # extend "\n手心粘稠依旧。"
    extend "\nYour palms as sticky as ever."

# game/scripts/route1.rpy:1227
translate english route1_start_836520c4:

    # extend "\n痛觉早已麻木，你厚实的第二层皮肤将那无用的感官尽数咽下，同时把一种绝不可饶恕的体验传进你的血管，鞭辟入里。"
    extend "\nPain had gone numb long ago. Your thick second skin swallowed that useless sensation whole and drove something else into your veins instead - an unforgiveable experience, worked all the way in."

# game/scripts/route1.rpy:1229
translate english route1_start_0aa0300c:

    # ahe "别...请不要..."
    ahe "Don't...please don't..."

# game/scripts/route1.rpy:1230
translate english route1_start_ee6758f7_1:

    # ahe "啊...！"
    ahe "Ah...!"

# game/scripts/route1.rpy:1231
translate english route1_start_84f7bc22:

    # ahe "啊——不要——不要啊啊啊啊啊啊啊啊！"
    ahe "Ah——no——no aaaaaaaaah!"

# game/scripts/route1.rpy:1233
translate english route1_start_dd5e0d2b:

    # centered_large_narrator "快感。"
    centered_large_narrator "Pleasure."

# game/scripts/route1.rpy:1236
translate english route1_start_8839597b:

    # centered_large_narrator "你回忆起了快感。"
    centered_large_narrator "You remember now. Pleasure."

# game/scripts/route1.rpy:1242
translate english route1_start_8b815b97:

    # large_narrator "你正欲一拳轰向自己的太阳穴死而后快，可你那呼啸的拳头却只能砸在软绵绵的沙地上，连自己的脸颊都碰不到就泄尽了力气。"
    large_narrator "You wanted to drive a fist into your own temple and have it over with. Yet the fist came down roaring into the soft sand and spent itself before it got near your cheek."

# game/scripts/route1.rpy:1243
translate english route1_start_9a647610:

    # extend "\n呕吐欲再次升翻涌起来。"
    extend "\nThe urge to vomit rose once again."

# game/scripts/route1.rpy:1244
translate english route1_start_826f74eb:

    # extend "\n你屏住呼吸，一拳拳砸向沙地，却始终徒劳无功。"
    extend "\nYou held your breath and drove fist after fist into the sand, all but in vain."

# game/scripts/route1.rpy:1245
translate english route1_start_34d01662:

    # extend "\n把头颅从沙地中抽出也做不到，沙地像断头台的木枷般将你头颅死死扼住。"
    extend "\nYou couldn't pull your head out, either. The ground held it the way a guillotine's yoke holds a neck."

# game/scripts/route1.rpy:1246
translate english route1_start_c1740996:

    # extend "\n而刀板则迟迟不落下。"
    extend "\nAnd the blade would not come down."

# game/scripts/route1.rpy:1247
translate english route1_start_9f70b262:

    # extend "\n它在等你自己动手。"
    extend "\nIt was waiting for you to do it yourself."

# game/scripts/route1.rpy:1253
translate english route1_start_d9d0a44d:

    # large_narrator "无力忍耐眼前非人的幻象，你死死扼住自己沙地以上的脖颈。"
    large_narrator "Unable to take another second of the thing in front of you, you clamped your hands around what was left of your neck above the sand."

# game/scripts/route1.rpy:1254
translate english route1_start_886bf56a:

    # extend "\n锁骨似乎断了，但那疼痛反倒让呕吐欲减轻了些。"
    extend "\nYour collarbone seemed to have snapped. The pain eased the nausea a little."

# game/scripts/route1.rpy:1255
translate english route1_start_e0557d36:

    # extend "\n脑血管轰鸣，视野四周开始坍缩，黑暗自无形中侵入进来。"
    extend "\nThe vessels in your head roared. Your vision started collapsing inward, and the dark came in from nowhere."

# game/scripts/route1.rpy:1256
translate english route1_start_6c74a49a:

    # extend "\n地心引力渐强，你的身躯逐渐被沙砾吞没。窒息终于在眼球中冒出的血污将你口鼻覆盖之前到来了。"
    extend "\nGravity leaned harder and the sand took your body under. Suffocation got there at last, just before the gore out of those eyeballs closed over your mouth and nose."

# game/scripts/route1.rpy:1257
translate english route1_start_beeffa42:

    # extend "\n死亡，你此刻唯一的救赎，她在你面前舒展开魅惑的身躯。"
    extend "\nDeath - the only salvation you had left - unfolded herself in front of you. She was lovely."

# game/scripts/route1.rpy:1258
translate english route1_start_1fd76c56:

    # extend "\n黑暗，一切都坠入黑暗，你的视野、身躯，你无际的意识。"
    extend "\nDarkness. Everything went dark - your sight, your body, your endless mind."

# game/scripts/route1.rpy:1259
translate english route1_start_140be7f8:

    # extend "\n黑暗。"
    extend "\nDarkness."

# game/scripts/route1.rpy:1269
translate english route1_start_4fec8fdd:

    # large_narrator "——但你也不能就这样一走了之。"
    large_narrator "——But you can't simply walk away either."

# game/scripts/route1.rpy:1270
translate english route1_start_9bfe5d14:

    # extend "\n——你早就明白这一点了。"
    extend "\n——You've known that since you came here."

# game/scripts/route1.rpy:1271
translate english route1_start_467eee7f:

    # extend "\n——即使如此也要继续折磨自己？"
    extend "\n——And you'll keep tearing yourself open anyway?"

# game/scripts/route1.rpy:1272
translate english route1_start_3dccca96:

    # extend "\n意识消散的前一刻，你依稀听见一个温柔声音在你耳边低语。"
    extend "\nIn the last moment before your mind went out, you half-heard a gentle voice at your ear."

# game/scripts/route1.rpy:1273
translate english route1_start_b597496b:

    # extend "\n——不如再次伸出手去，撕——"
    extend "\n——Why not reach out one more time, and tear——"

translate english strings:

    # game/scripts/route1.rpy:774
    old "保持呼吸。"
    new "Keep breathing."

    # game/scripts/route1.rpy:799
    old "放弃。"
    new "Give up."

