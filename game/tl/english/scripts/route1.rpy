translate english route1_start_6b0000f8:

    # ahe "再无所事事都胜过和你困在这里。"
    ahe "Much better than being stuck here with you."

# game/scripts/route1.rpy:202
translate english route1_start_71ddcde1:

    # wangshuang "啊，已经这么遭人嫌了么..."
    wangshuang "Oh my, certainly didn't expect this bad name for myself."

# game/scripts/route1.rpy:203
translate english route1_start_a1bc16ee:

    # ahe "...多少有点自知之明吧你..."
    ahe "You know what you've done."

# game/scripts/route1.rpy:204
translate english route1_start_c69bb3cd:

    # wangshuang "彼此彼此吧，我们都只是遵循着强烈的愿望，尝试了一直以来想要尝试的事情。"
    wangshuang "You know very well that we did very similar things, following our very strong wants."

# game/scripts/route1.rpy:205
translate english route1_start_2406d3f4:

    # ahe "区别在于我不需要陪葬者。"
    ahe "The difference is, I don't drag people down with me."

# game/scripts/route1.rpy:206
translate english route1_start_a54167b0:

    # wangshuang "不，区别在于我做到了，而你没有。"
    wangshuang "The real difference is, I got what I wanted, and you didn't."

# game/scripts/route1.rpy:207
translate english route1_start_eb7e9e7f_5:

    # ahe "..."
    ahe "..."

# game/scripts/route1.rpy:208
translate english route1_start_f893d273:

    # wangshuang "而你拒绝与我共处一室的真正原因只是嫉妒，仅此而已。"
    wangshuang "And the sole reason you refuse to get stuck here with me is envy, and that is it."

# game/scripts/route1.rpy:209
translate english route1_start_184c8c36:

    # ahe "闭嘴吧..."
    ahe "Shut up..."

# game/scripts/route1.rpy:210
translate english route1_start_789ab060:

    # wangshuang "我闭嘴又有什么用？难道你那苍白的“理想”就不需要陪葬者了？"
    wangshuang 'So what if I did? Do you dare say that pale "dream" of yours needed no sacrifice?'

# game/scripts/route1.rpy:211
translate english route1_start_5e494470:

    # wangshuang "你为了尤里娅那小姑娘折断了多少人的骨头？阿鹤，狡辩是没有意义的，无论如何我们都是逝乐园覆灭的共犯。"
    wangshuang "How many bones did you break for that little girl Yulia? Kaku, my man, there is no need to quibble. We are accomplices in destroying the PL District no matter how you look at it."

# game/scripts/route1.rpy:212
translate english route1_start_eb7e9e7f_6:

    # ahe "..."
    ahe "..."

# game/scripts/route1.rpy:213
translate english route1_start_de45be2d:

    # wangshuang "所以不如放下成见，吃点团子，如何？"
    wangshuang "So why don't we drop the prejudice and have some mochi?"

# game/scripts/route1.rpy:215
translate english route1_start_eb7e9e7f_7:

    # ahe "..."
    ahe "..."

# game/scripts/route1.rpy:217
translate english route1_start_fc8adc2c:

    # wangshuang "这就对了嘛，来都来了。"
    wangshuang "That's more like it. Eat up."

# game/scripts/route1.rpy:218
translate english route1_start_eb7e9e7f_8:

    # ahe "..."
    ahe "..."

# game/scripts/route1.rpy:219
translate english route1_start_386ba371:

    # wangshuang "有件事你可能不知道，他们家团子是加了KAS才这么好吃的。"
    wangshuang "FYI, their mochi is good because it's laced with KAS."

# game/scripts/route1.rpy:220
translate english route1_start_4b4f4fe6:

    # ahe "哦，所以之后我会上瘾？"
    ahe "Oh, so I probably will get addicted after this?"

# game/scripts/route1.rpy:221
translate english route1_start_9ca6b8c7:

    # wangshuang "也许。"
    wangshuang "Maybe."

# game/scripts/route1.rpy:222
translate english route1_start_be8fed07:

    # ahe "也好吧。"
    ahe "Fine with me."

# game/scripts/route1.rpy:224
translate english route1_start_7e10071b:

    # wangshuang "靠染上新瘾来戒旧瘾可是个无底洞啊。"
    wangshuang "Fighting old addiction with new ones is a real rabbit hole, mind you."

# game/scripts/route1.rpy:225
translate english route1_start_b54e9550:

    # ahe "你自己不也在做同样的事情。"
    ahe "As if you are not doing the same thing."

# game/scripts/route1.rpy:226
translate english route1_start_52a96c38:

    # wangshuang "只是不想看着我欣赏的人和我坠入同样的深渊嘛。"
    wangshuang "My my, I just don't want to see people I appreciate going down the same degenerate path I did, you know."

# game/scripts/route1.rpy:227
translate english route1_start_13ae7282:

    # ahe "别恶心我了，求你了。"
    ahe "Stop this shit, I beg you."

# game/scripts/route1.rpy:228
translate english route1_start_fd8a16ba:

    # wangshuang "你这人，连真心话都不让人说。"
    wangshuang "This guy! Won't even let me be honest."

