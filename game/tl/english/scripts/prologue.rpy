translate english route1_prologue_6ddc8496:

    # extend "所以想不想出去溜达溜达？——"
    extend "So, wanna head out?——"

# game/scripts/prologue.rpy:84
translate english route1_prologue_3099c900:

    # extend "向一个不具备意志的人征求认可又是何苦？"
    extend "What's the point of asking the opinion of someone that has no will for anything?"

# game/scripts/prologue.rpy:85
translate english route1_prologue_bf2805e1:

    # extend "彰显你那虚伪的开明？——"
    extend "Just to showcase your fake-ass generosity?——"

# game/scripts/prologue.rpy:86
translate english route1_prologue_a50caa72:

    # extend "那就当你同意了。——"
    extend "I'll take that as a yes.——"

# game/scripts/prologue.rpy:87
translate english route1_prologue_5261feb5:

    # extend "请自便吧。"
    extend "Suit yourself."

# game/scripts/prologue.rpy:105
translate english route1_prologue_83f95ac3:

    # extend "可眼前只有一片黑暗，比你所熟知的海底更加幽深。"
    extend "\\nBut there was only darkness in front of you, even darker than the deep ocean where you just came from."

# game/scripts/prologue.rpy:106
translate english route1_prologue_83d58ecb:

    # extend "世界本就是海，海平面以上自然一无所有。"
    extend "\\nThe ocean is the world. Naturally, there is nothing above the surface."

# game/scripts/prologue.rpy:107
translate english route1_prologue_1096db65:

    # extend "你模糊地记得这一点。"
    extend "\\nYou vaguely remembered that."

# game/scripts/prologue.rpy:110
translate english route1_prologue_b225bb4b:

    # large_narrator "失望之余，你肆意俯身漂浮，不再试图活动任何肌肉，只是慵懒地咪着双眼。"
    large_narrator "In dismay, you let yourself afloat, no longer moving even a single muscle. All you did was stare down with a lazy gaze."

# game/scripts/prologue.rpy:111
translate english route1_prologue_7bfa80df:

    # extend "你想，也许能从水下那幽暗世界里看出些什么。"
    extend "You thought you might spot something from that dark underwater world."

# game/scripts/prologue.rpy:112
translate english route1_prologue_dbc5d663:

    # extend "但终究是什么都没有。"
    extend "\\nBut there was nothing after all."

# game/scripts/prologue.rpy:113
translate english route1_prologue_37f16b3b:

    # extend "在长久的漂浮中，你渐渐忘记了消逝的体温，忘记了静脉里潺潺流动的暗红血液，忘记了你究竟为什么来到这里。"
    extend "\\nYou started to lose track of your body temperature, your blood flow, and your reason for being."

# game/scripts/prologue.rpy:114
translate english route1_prologue_0b256fc2:

    # extend "你忘记了呼吸。"
    extend "\\nYou started to lose track of your breathing."

# game/scripts/prologue.rpy:119
translate english route1_prologue_c7a46f6e:

    # extend "本该是这样的。"
    extend "\\nThat should have been the case."

# game/scripts/prologue.rpy:120
translate english route1_prologue_23825c11:

    # extend "但你累了，实在是太累了。"
    extend "But you felt tired, way too fatigued."

# game/scripts/prologue.rpy:121
translate english route1_prologue_6706392c:

    # extend "长时间保持不动竟是一件如此令人疲惫的事。"
    extend "You had no idea that staying still for a long time could be this tiring."

# game/scripts/prologue.rpy:122
translate english route1_prologue_b0801505:

    # extend "每一寸肌肉都从黑夜中啜饮势能，苦苦等待爆发的那一刻——"
    extend "Every thread of muscle was drinking in energy from the darkness, awaiting the moment to burst——"

# game/scripts/prologue.rpy:123
translate english route1_prologue_5e61945d:

    # extend "终究不会到来的那一刻。"
    extend "the moment that would never arrive."

# game/scripts/prologue.rpy:124
translate english route1_prologue_cfb4b743:

    # extend "你在永恒的凝滞中被倦意填满。"
    extend "\\nYou were filled by lethargy in this eternal stasis."

# game/scripts/prologue.rpy:125
translate english route1_prologue_a0278faa:

    # extend "然而来者终归要到来——"
    extend "But the arriving one will eventually arrive——"

# game/scripts/prologue.rpy:126
translate english route1_prologue_0459b099:

    # extend "应你之邀而来。"
    extend "as per your invitation."

# game/scripts/prologue.rpy:127
translate english route1_prologue_d31eeba2:

    # extend "自己种下了树，就必要咽下它结的果。"
    extend "\\nYou will reap what you sow."

# game/scripts/prologue.rpy:134
translate english route1_prologue_b8092cd0:

    # extend "于是就这样，你纹丝不动地在闪着微光的海面上漂浮，宛如一段朽木。"
    extend "\\nSo you stayed still and afloat on the ocean surface, like a log of rotten wood."

# game/scripts/prologue.rpy:135
translate english route1_prologue_1114fc47:

    # extend "假装一切都没有发生。"
    extend "\\nAs if nothing ever happened."

